# ============================================================================
# ROOT-LEVEL IGNORE RULES
#
# The sub-projects keep their own rules (padhaanewala/.gitignore and
# padhaanewala/frontend/.gitignore). Those apply to everything beneath them, so
# this file exists only to cover paths at the repository root -- chiefly env
# files created there, which nothing was protecting.
# ============================================================================

# Environment files - never commit real values
.env*
!.env.example
# Compose-shaped production template (see padhaanewala/.env.prod.example). A
# nested .gitignore is not overridden by this file, so both need the negation.
!.env.prod.example

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# Run logs. `*.log` lives in padhaanewala/.gitignore, which only covers paths
# beneath padhaanewala/ -- so the repository-root logs/ directory was
# unprotected and both files in it were committed, one carrying a local
# filesystem path and the other a LAN address.
logs/

# Logs. The root .gitignore had no *.log rule, so a dev server started from the
# repository root left backend.log and dev.log untracked-but-unprotected -- a
# plain `git add -A` would have committed them.
*.log

# uvicorn/npm stdout+stderr captures. `*.log` does not match these, and a
# SQLAlchemy error message can embed the connection string and credentials.
*.err
*.out

# Local database artifacts. Both directories are regenerable output, and the
# second holds binary pg_dump files that have no business in history:
#   backend/var/   media uploads, test uploads, and pre-operation .dump backups
#   backend/data/  catalogue CSV exports from scripts/export_catalog_csvs.py
padhaanewala/backend/var/
padhaanewala/backend/data/

# Local agent/tooling state. .opencode/ is machine-local (installed skills,
# hooks and their node_modules), not part of the application source.
.opencode/

# Defence in depth. The nested .gitignore files already cover these, but a stray
# copy at the root would otherwise be unprotected.
node_modules/
.next/
__pycache__/
*.tsbuildinfo
*.py[cod]

# Removed from GitHub but kept locally: duplicated assets, one-off scripts,
# stale raw evidence, and superseded 15-case browser test generators.
/padhaanewala/bot_robot.glb
/padhaanewala/backend/reseed_mock_tests.py
/padhaanewala/testsprite_tests/antigravity-backend-results.txt
/padhaanewala/testsprite_tests/sanitize_generated_scripts.ps1
/padhaanewala/.agents/skills/test-everything/test-everything/
/padhaanewala/testsprite_tests/TC001_Log_in_and_reach_the_dashboard.py
/padhaanewala/testsprite_tests/TC002_Start_a_mock_test_and_answer_questions_under_the_timer.py
/padhaanewala/testsprite_tests/TC003_Register_and_reach_the_dashboard.py
/padhaanewala/testsprite_tests/TC004_Submit_a_mock_test_and_review_results.py
/padhaanewala/testsprite_tests/TC005_Start_a_mock_test_attempt_from_the_catalog.py
/padhaanewala/testsprite_tests/TC006_Start_and_complete_a_mock_test_attempt.py
/padhaanewala/testsprite_tests/TC007_Find_a_college_from_the_homepage_search.py
/padhaanewala/testsprite_tests/TC008_Browse_colleges_and_open_a_college_detail_page.py
/padhaanewala/testsprite_tests/TC009_Block_protected_pages_until_sign_in.py
/padhaanewala/testsprite_tests/TC010_Complete_a_mock_test_and_submit_answers.py
/padhaanewala/testsprite_tests/TC011_Redirect_unauthenticated_visitors_away_from_the_admin_console.py
