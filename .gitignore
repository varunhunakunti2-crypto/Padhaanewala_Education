# ============================================================================
# ROOT-LEVEL IGNORE RULES
#
# The sub-projects keep their own rules (padhaanewala/.gitignore and
# padhaanewala/frontend/.gitignore). Those apply to everything beneath them, so
# this file exists only to cover paths at the repository root -- chiefly env
# files created there, which nothing was protecting.
# ============================================================================

# Environment files - never commit real values
.env*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# Run logs. `*.log` lives in padhaanewala/.gitignore, which only covers paths
# beneath padhaanewala/ -- so the repository-root logs/ directory was
# unprotected and both files in it were committed, one carrying a local
# filesystem path and the other a LAN address.
logs/

# uvicorn/npm stdout+stderr captures. `*.log` does not match these, and a
# SQLAlchemy error message can embed the connection string and credentials.
*.err
*.out
