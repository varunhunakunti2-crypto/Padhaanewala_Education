# ============================================================================
# ROOT-LEVEL IGNORE RULES
#
# The sub-projects keep their own rules (padhaanewala/.gitignore and
# padhaanewala/frontend/.gitignore). Those apply to everything beneath them, so
# this file exists only to cover paths at the repository root -- chiefly env
# files created there, which nothing was protecting.
# ============================================================================

# Environment files - never commit real values
.env*
!.env.example

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/

# Logs. The root .gitignore had no *.log rule, so a dev server started from the
# repository root left backend.log and dev.log untracked-but-unprotected -- a
# plain `git add -A` would have committed them.
*.log

# Local database artifacts. Both directories are regenerable output, and the
# second holds binary pg_dump files that have no business in history:
#   backend/var/   media uploads, test uploads, and pre-operation .dump backups
#   backend/data/  catalogue CSV exports from scripts/export_catalog_csvs.py
padhaanewala/backend/var/
padhaanewala/backend/data/

# Defence in depth. The nested .gitignore files already cover these, but a stray
# copy at the root would otherwise be unprotected.
node_modules/
.next/
__pycache__/
*.tsbuildinfo
*.py[cod]
