# ============================================================================
# PADHAANEWALA — PRODUCTION ENV TEMPLATE (docker-compose.prod.yml)
# ============================================================================
# Copy to `.env.prod`, fill in every `change-me`, then start the stack:
#
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# `.env.prod` is gitignored (`.env*` with `!.env.example` / `!.env.prod.example`),
# so the real secrets never reach Git.
#
# WHY THIS FILE EXISTS SEPARATELY FROM `.env.example`
#   `.env.example` is the *development* template. It is missing the variables
#   only Compose reads (`SITE_ADDRESS`, `ACME_EMAIL`, `DB_*` in Compose shape,
#   the frontend build arg) and it ships values that production refuses
#   (`EMAIL_PROVIDER=console`, `SMS_PROVIDER=console`, `change-me` secrets).
#   Copying it and starting the production stack fails at the first `${VAR:?}`
#   check, which reads as a Compose bug rather than a missing value.
#
# NOT THE SAME FILE AS `.env.deploy`
#   `.env.deploy` is the Render + Vercel demo artifact (see `render.yaml`). It
#   cannot boot this stack and is not meant to:
#     * it has no DB_NAME/DB_USER/DB_PASSWORD — it has a Render `DATABASE_URL`,
#       but docker-compose.prod.yml rebuilds DATABASE_URL from the three DB_*
#       values and never reads a supplied one (see line 202 there);
#     * it is written for `APP_ENV=staging`, while the Compose file hardcodes
#       `APP_ENV: production` on the backend and ignores the env-file value;
#     * it uses `EMAIL_PROVIDER=console` / `SMS_PROVIDER=console`, which the
#       production guards in backend/app/config.py refuse outright.
#
# WHY EVERY VALUE BELOW IS A PLACEHOLDER
#   Compose's `${VAR:?}` only checks that a value is non-empty, so this file is
#   enough to validate the Compose file offline:
#
#     docker compose --env-file .env.prod.example -f docker-compose.prod.yml \
#       config --quiet
#
#   It is deliberately NOT enough to run the stack. backend/app/config.py
#   refuses to boot with `change-me` signing keys, the dev database password, a
#   `console` provider or an unregistered DLT template, and frontend/next.config.ts
#   refuses to build (APP_ENV=production) with an empty grievance-officer name.
#   That is the intended safety net: a copy of this file that was never filled in
#   fails loudly instead of serving traffic with known-bad configuration.
# ============================================================================

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# The browser-visible origin, with scheme. This is what CORS and canonical URLs
# describe; it is not what Caddy listens on (that is SITE_ADDRESS).
APP_URL=https://change-me.invalid
# Internal API base as reached from the frontend container. The Compose file
# sets BACKEND_URL=http://backend:8000 on the frontend for the rewrite, so this
# value is informational here; keep it on the Compose network, not the public
# hostname, or the rewrite loops frontend -> Caddy -> frontend.
API_URL=http://backend:8000
# Host headers the backend accepts, comma-separated, never `*`. The Compose file
# appends `backend` itself (Next's rewrite sets Host to the rewrite destination,
# so FastAPI sees `backend:8000`); omitting it makes every /api/v1 call answer
# 400 while pages still render 200. List the real apex/www domains here.
ALLOWED_HOSTS=change-me.invalid,www.change-me.invalid
# Never `*`: allow_credentials=True plus a wildcard lets any site read
# authenticated responses out of a logged-in visitor's browser.
CORS_ORIGINS=https://change-me.invalid

# Three DIFFERENT values. config.py refuses to boot if either JWT key is empty or
# `change-me`, and if the refresh key equals the access key (a shared key means a
# refresh token verifies as an access token). Generate them with:
#   openssl rand -hex 32
# SECRET_KEY additionally derives the AES key that encrypts stored AI provider
# credentials (app/services/secret_box.py), so changing it later makes those
# rows undecryptable. Treat all three as permanent.
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL container)
# ---------------------------------------------------------------------------
# These three are what Compose uses both to initialise the `db` container and to
# build DATABASE_URL. Do NOT set DATABASE_URL here: the Compose file assigns it
# explicitly, so a value in this file is silently ignored, and expecting
# otherwise is exactly how the Render file fails to boot.
#
# The password is interpolated into DATABASE_URL raw, so it must be URL-safe:
# no `@`, `/`, `:` or `?`. `openssl rand -hex 24` is hex and always safe.
# `dev_password_123` is refused in production.
DB_NAME=padhaanewala
DB_USER=padhaanewala
DB_PASSWORD=change-me
# Optional pool tuning (defaults shown). Keep max_connections on the server above
# DB_POOL_SIZE + DB_MAX_OVERFLOW + headroom for migrations and seed scripts.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
# Production refuses `console`: it silently discards every verification and
# reset link while EMAIL_VERIFICATION_REQUIRED still blocks login, producing a
# site nobody can sign in to.
#
#   EMAIL_PROVIDER=sendgrid  -> EMAIL_API_KEY must be a real, non-placeholder key
#   EMAIL_PROVIDER=smtp      -> EMAIL_SMTP_HOST, EMAIL_SMTP_USER and
#                               EMAIL_SMTP_PASSWORD must all be real
#
# Uncomment one block and delete the other.
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=change-me
# EMAIL_PROVIDER=smtp
# EMAIL_SMTP_HOST=change-me.invalid
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=change-me
# EMAIL_SMTP_PASSWORD=change-me
# The sender must be a real mailbox on a domain with SPF/DKIM for the provider.
EMAIL_FROM_EMAIL=no-reply@change-me.invalid
EMAIL_FROM_NAME=Padhaanewala
# Defaults to true. Leaving it true means a broken mail provider locks every new
# account out at the verification step — verify delivery before launch.
EMAIL_VERIFICATION_REQUIRED=true

# ---------------------------------------------------------------------------
# SMS
# ---------------------------------------------------------------------------
# Production must use msg91 with a real key and a registered DLT template id;
# `console` and placeholder values are refused, because a send without an
# approved template is rejected at the provider while the app reports healthy.
SMS_PROVIDER=msg91
SMS_API_KEY=change-me
SMS_SENDER_ID=PADNEWL
SMS_DLT_TEMPLATE_ID=change-me

# ---------------------------------------------------------------------------
# BOOTSTRAP (read by backend/docker-entrypoint.sh, not by the application)
# ---------------------------------------------------------------------------
#   RUN_MIGRATIONS=true  alembic upgrade head before the server starts, so a
#     deploy can never serve against an older schema. Idempotent; leave true.
#   RUN_SEEDS=true       loads the six reference-data sets. Migrations create the
#     schema but not the rows, and without them the app is "healthy" while
#     registration 503s and authenticated requests 403s (roles come from the DB).
#     Safe and idempotent, but intended for a host's first deploy.
RUN_MIGRATIONS=true
RUN_SEEDS=false

# ---------------------------------------------------------------------------
# ADMIN BOOTSTRAP — NOT read by Compose or by the entrypoint
# ---------------------------------------------------------------------------
# `RUN_SEEDS` does NOT create an administrator; the seed list in
# backend/docker-entrypoint.sh stops at reference data. Create one after the
# stack is healthy, from the backend container:
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml \
#     exec -e ADMIN_PASSWORD='...' backend python scripts/seed_admin.py
#
# That is why an empty ADMIN_PASSWORD here would not have stopped the stack from
# booting: nothing in the boot path reads it. `scripts/seed_admin.py` is the only
# reader, and it refuses to run with an empty password. Keep these values out of
# this file and pass them on the command line as above.
# ADMIN_EMAIL=contact@change-me.invalid
# ADMIN_EMAIL_ALLOWLIST=contact@change-me.invalid
# ADMIN_PASSWORD=
# ADMIN_NAME=Padhaanewala Admin
# ADMIN_MOBILE=9999999999
# ADMIN_ROLES=admin,super_admin

# ---------------------------------------------------------------------------
# FRONTEND BUILD ARGS
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the browser bundle by `next build`, so these are
# build args, not runtime environment. `docker compose build` is required after
# changing them; `up` alone reuses the old image.
NEXT_PUBLIC_SITE_URL=https://change-me.invalid
# Statutory, not branding: the Consumer Protection Act 2019 and IT Rules 2021
# require a *named* grievance officer to be published. next.config.ts refuses to
# build with this empty, but only checks emptiness — a placeholder passes. There
# is no guard that can catch "change-me" here, so replace it before building.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=change-me
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=+91-0000000000

# ---------------------------------------------------------------------------
# EDGE (Caddy)
# ---------------------------------------------------------------------------
# The public domain Caddy issues a certificate for. Its A/AAAA record must
# already point at this host or issuance fails and the 443 listener never comes
# up — which presents as "the site works on localhost, nothing on 443". No port:
# this stack publishes 80/443, and `localhost:28443` belongs to
# docker-compose.localtest.yml (which also sets HTTPS_PORT_SUFFIX — do not copy
# that here).
SITE_ADDRESS=change-me.invalid
# Where Let's Encrypt sends expiry and incident mail. Use a mailbox you read.
ACME_EMAIL=admin@change-me.invalid

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------
# Upload cap in bytes (default 5 MiB). MEDIA_ROOT is set by the Compose file and
# must stay absolute: the backend container runs read_only, so the only writable
# path is the explicit volume mount.
# MEDIA_MAX_BYTES=5242880
