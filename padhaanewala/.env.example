# ============================================================================
# PADHAANEWALA — ENVIRONMENT VARIABLES
# Copy to `.env.development` (or `.env.production`) and fill in values.
# NEVER commit real values to Git.
#
# Every variable below is read by the code. Phase 5.5 removed the 45 that were
# not — a file that documents subsystems that do not exist is how this template
# drifted from the code in the first place: the DATABASE_URL it shipped declared
# an `asyncpg` driver that is not in requirements.txt, so an unedited copy of
# the template produced an application that could not start. The list of what
# was removed, and why, is at the foot of this file.
#
# Three groups read this file, and they are not interchangeable:
#   * the FastAPI backend           — every name below with no prefix
#   * the Next.js *server*          — BACKEND_URL, CSP_IMAGE_HOSTS, OPENAI_*
#   * the browser                   — only NEXT_PUBLIC_* names
# Anything server-side is deliberately NOT prefixed: a NEXT_PUBLIC_ variable is
# compiled into the JavaScript bundle and is readable by every visitor.
# ============================================================================

# ---------------------------------------------------------------------------
# APP  (backend/app/config.py)
# ---------------------------------------------------------------------------
# APP_ENV is what selects the production guards in config.py and the build
# guard in next.config.ts. Note the distinction from NODE_ENV: NODE_ENV is
# "production" for every local `next build`, so gating on it would make the
# repository unbuildable.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
# Hosts accepted in the Host header. REQUIRED in production. Never "*".
ALLOWED_HOSTS=localhost,127.0.0.1
# Number of reverse proxies in front of the app (Caddy/Cloudflare/nginx = 1).
# X-Forwarded-For is only honoured when this matches the real topology, because
# the header is client-controlled and would otherwise allow rate-limit bypass
# and audit-log spoofing. 0 = ignore the header, use the socket peer.
TRUSTED_PROXY_HOPS=0
# Which file pydantic-settings reads. Set by the test harness to keep the suite
# off the development database; leave it alone otherwise.
# PADHAANEWALA_ENV_FILE=.env.development

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
# 5433 is the port docker-compose.dev.yml publishes for the container
# (5433:5432). Only 5432 if you run a native Windows PostgreSQL instead.
DB_PORT=5433
DB_NAME=padhaanewala_dev
DB_USER=padhaanewala
DB_PASSWORD=change-me
# Driver MUST match requirements.txt: psycopg2-binary is installed, asyncpg is
# not. The DB_* fields above are informational only — DATABASE_URL is what the
# application actually connects with, and once it exists the DB_* values are not
# re-read. Setting DB_PASSWORD without DATABASE_URL leaves the app on the dev
# default and the production guard refuses to boot.
DATABASE_URL=postgresql+psycopg2://padhaanewala:change-me@localhost:5433/padhaanewala_dev
# A local .env.development overrides this file and wins with no warning, because
# config.py loads it via env_file=. If yours says 5432 while this says 5433, the
# app talks to a native server, NOT the container from docker-compose.dev.yml,
# and you get an auth error that looks like a bad password. DB_PORT above does
# not arbitrate: nothing reads it. Check the port in your own .env.development
# before suspecting the compose file.
# Connection pool. Keep max_connections on the server above
# DB_POOL_SIZE + DB_MAX_OVERFLOW + headroom for the seed scripts and psql.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# REDIS
# ---------------------------------------------------------------------------
# Backs the rate limiter only. There is no cache layer and no task queue.
REDIS_URL=redis://localhost:6379/0
# Command timeout on the request path. Deliberately small: a Redis node that is
# unreachable must fail fast so the rate limiter can apply its open/closed
# policy, rather than holding a request open for redis-py's 5s default.
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
# Ping budget for `GET /health`, which reports degraded when it cannot answer.
REDIS_HEALTH_TIMEOUT_SECONDS=0.5
# When a Redis failure removes a rate limit, do those routes fail open? `true`
# is correct for lead capture and the predictor. The auth namespace ignores this
# and always fails closed, so a Redis outage cannot be turned into unlimited
# login attempts.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FAIL_OPEN=true

# ---------------------------------------------------------------------------
# AUTH / SESSIONS
# ---------------------------------------------------------------------------
# Three DIFFERENT values, each 64 hex characters from `openssl rand -hex 32`.
# Production refuses to boot if either is a placeholder or if the two signing
# keys are equal — a shared key means a refresh token verifies as an access
# token.
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
# Must be an HMAC algorithm. Asymmetric algorithms would need a public key and
# are not configured, so production refuses RS*/ES*.
JWT_ALGORITHM=HS256
# Access tokens are stateless and cannot be revoked, so this lifetime IS the
# containment window for one that leaks. Production caps it at
# MAX_ACCESS_TOKEN_EXPIRE_MINUTES.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
# Session ledger (Phase 3). The refresh token is delivered as an HttpOnly cookie
# scoped to REFRESH_COOKIE_PATH — never in a response body any script can read.
# MAX_ACTIVE_REFRESH_TOKENS bounds concurrent devices, not rows: one device
# refreshing every 25 minutes writes ~1,700 rows over its 30-day life and must
# never be treated as 1,700 sessions.
REFRESH_COOKIE_NAME=pdw_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
MAX_ACTIVE_REFRESH_TOKENS=8

# ---------------------------------------------------------------------------
# EMAIL — verification and password reset
# ---------------------------------------------------------------------------
# `console` writes the message to the log instead of sending it, and production
# refuses to boot with it: verification links would never arrive while
# EMAIL_VERIFICATION_REQUIRED still blocks login, which is a site nobody can
# sign in to.
#
#   sendgrid: set EMAIL_API_KEY
#   smtp:     set EMAIL_SMTP_HOST / _PORT / _USER / _PASSWORD, leave the key blank
EMAIL_PROVIDER=console
EMAIL_API_KEY=change-me
EMAIL_SMTP_HOST=smtp.mailtrap.io
# Must be a number even when unused — an empty value fails pydantic's int
# parsing and stops the container booting.
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=change-me
EMAIL_SMTP_PASSWORD=change-me
# The sender must be a domain you control, or deliverability is zero.
EMAIL_FROM_EMAIL=no-reply@padhaanewala.in
EMAIL_FROM_NAME=Padhaanewala
# When true, POST /auth/login refuses an unconfirmed address with 403.
EMAIL_VERIFICATION_REQUIRED=false
# Email links are long-lived: they are single-use and are the sole recovery
# path. A password-reset link is short-lived because it is a bearer credential
# for the account itself.
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# SMS — mobile verification and passwordless login (MSG91)
# ---------------------------------------------------------------------------
# India requires a registered DLT template id per transactional message, so the
# template id is a first-class setting: a send without one is rejected at the
# provider and the app would boot "healthy" and fail every OTP. Production
# refuses to boot on `console` or on a placeholder key or template.
SMS_PROVIDER=console
SMS_API_KEY=change-me
SMS_SENDER_ID=PADNEWL
SMS_DLT_TEMPLATE_ID=change-me
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
# Brute-force bounds. Five verify attempts against a 6-digit code is 0.0005% of
# the keyspace per window; there is no lockout to bypass, only a limit to wait
# out.
SMS_OTP_MAX_SENDS_PER_WINDOW=3
SMS_OTP_RATE_WINDOW_MINUTES=10
SMS_OTP_MAX_VERIFY_ATTEMPTS=5

# ---------------------------------------------------------------------------
# UPLOADED MEDIA
# ---------------------------------------------------------------------------
# Where uploaded images are written, and served back from by
# GET /api/v1/media/files/{id}. Relative is fine in development.
#
# In production this must be an absolute path at least two levels deep, and
# docker-compose.prod.yml already sets it to /var/lib/padhaanewala/media backed by
# a named volume. Two failure modes make that non-optional, and config.py refuses
# to boot rather than leave either to be discovered later:
#   * A relative root resolves against the process working directory. In a
#     container that is inside the image's writable layer, so every upload
#     succeeds and every file is destroyed by the next `up --build`. Nothing
#     raises; the images simply stop existing.
#   * The files are served from this app's own origin, so whatever else lives
#     under this root is reachable through the serving route.
# The production value is set in the compose file and is not read from here.
MEDIA_ROOT=var/media
# Per-file ceiling, checked against the bytes actually read rather than the
# declared Content-Length, which the client controls. Production caps this at
# 50 MiB.
MEDIA_MAX_BYTES=5242880
# Public path prefix for the serving route. Baked into `media.url` when a row is
# written and compared against to decide whether a file is ours to serve, so
# changing it after seeding orphans existing rows. Do not change.
MEDIA_URL_PREFIX=/api/v1/media/files

# ---------------------------------------------------------------------------
# BOOTSTRAP ADMIN — read by backend/scripts/seed_admin.py, not by the app
# ---------------------------------------------------------------------------
# ADMIN_PASSWORD has no default on purpose: the script refuses to run without it.
# ADMIN_EMAIL_ALLOWLIST is a hard gate — the script will not touch any other
# account, so a typo in ADMIN_EMAIL cannot promote a real student.
# users.mobile is NOT NULL + UNIQUE, so the admin needs a unique mobile here.
ADMIN_EMAIL=contact@padhaanewala.in
ADMIN_EMAIL_ALLOWLIST=contact@padhaanewala.in
ADMIN_PASSWORD=
ADMIN_NAME=Padhaanewala Admin
ADMIN_MOBILE=9999999999
ADMIN_ROLES=admin,super_admin

# ---------------------------------------------------------------------------
# NEXT.JS SERVER — read on the server only, never prefixed
# ---------------------------------------------------------------------------
# BACKEND_URL is read by lib/api-server.ts and by the /api/v1 rewrite in
# next.config.ts. Prefixing it would ship an internal hostname to the browser.
BACKEND_URL=http://localhost:8000
# Extra image origins for the Content-Security-Policy `img-src`, comma-separated
# (proxy.ts). next/image proxies every remote image through /_next/image, so
# images.unsplash.com is already covered by 'self' and needs no entry here. List a
# host only if an admin can put that origin in the media library — the admin
# media and banner sections render <img src={url}> directly, so an unlisted
# origin is blocked rather than silently allowed.
CSP_IMAGE_HOSTS=
# Read by app/api/ai/route.ts, which is a Next route handler: the OpenAI call is
# made server-side and never appears in the browser bundle. Without a real key
# the route falls back to a canned offline response rather than failing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* — compiled into the browser bundle, readable by every visitor
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_API_URL is the browser-visible base. Leave it UNSET in
# development: lib/api.ts then defaults to the relative "/api/v1", which the
# rewrite in next.config.ts forwards to BACKEND_URL. Same-origin, so no CORS.
# If you must set it, it MUST include the /api/v1 suffix:
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# next.config.ts strips a trailing /api/v1 before proxying; lib/api.ts does not.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Statutory publication, not a branding choice. The Consumer Protection Act
# 2019 and the IT Rules 2021 both require a *named* grievance officer to be
# published; /legal/grievance renders this, and an undesignated officer means a
# notice may be treated as not served. `APP_ENV=production` refuses to build
# with the name empty.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=

# ---------------------------------------------------------------------------
# EDGE + DEPLOY  (docker-compose.prod.yml, docker/Caddyfile) — Phase 2
# ---------------------------------------------------------------------------
# These are read by *Compose*, not by the application. Compose interpolates
# them from the file in the project root before the container starts, and the
# `:?` form in docker-compose.prod.yml makes an unset one a hard failure rather
# than an empty string, so the stack refuses to come up half-configured. That
# is the intended behaviour: a container that boots with `APP_URL=""` is harder
# to diagnose than one that refuses to boot at all.
#
# The two below are the ones with no sensible default. The rest of the
# deployment variables (DB_*, SECRET_KEY, JWT_*_SECRET_KEY, the email and SMS
# provider credentials) are listed above under their own subsystem headings —
# they are read by both the dev stack and the production stack.
#
# The public domain Caddy issues a certificate for. It must be a name whose DNS
# A/AAAA record already points at this host, or issuance fails and the 443
# listener never comes up. Everything else in the topology works over plain HTTP
# on the Compose network, so a wrong value here presents as "the site is up on
# localhost but nothing is listening on 443".
SITE_ADDRESS=padhaanewala.in
# Where Let's Encrypt / ZeroSSL send expiry and incident mail. Use a real
# mailbox you read: this is the address that gets the "your certificate expires
# in N days" warning, and an unmonitored one means finding out from a customer.
ACME_EMAIL=
# Consumed by backend/docker-entrypoint.sh, not by the application.
#
#   RUN_MIGRATIONS=true  runs `alembic upgrade head` before the server starts,
#     so a deploy can never serve against a schema older than the code querying
#     it. Leave true; the migration is idempotent.
#   RUN_SEEDS=true       runs the six reference-data loaders, then remember to
#     set it back. Migrations create the schema but not the rows, and without
#     them the app is "healthy" — `SELECT 1` returns 200 — while registration
#     503s and every authenticated request 403s, because roles are read from the
#     database. Safe to set for a host's first deploy only.
RUN_MIGRATIONS=true
RUN_SEEDS=false

# ============================================================================
# REMOVED IN PHASE 5.5 — declared here, read by nothing
# ============================================================================
# 45 variables were removed because no code path reads them. They documented
# subsystems that do not exist, and an operator reasonably believed otherwise.
# Do not re-add one without the code that reads it.
#
#   Celery / queue   CELERY_BROKER_URL, CELERY_RESULT_BACKEND
#   Cache TTLs       CACHE_TTL_HOMEPAGE, _LIST, _DETAIL, _SCHOLARSHIP, _EXAM,
#                    _BLOG, _STATIC  — there is no application cache layer
#   Object storage   S3_ENDPOINT, _REGION, _ACCESS_KEY, _SECRET_KEY,
#                    S3_BUCKET_MEDIA, S3_BUCKET_PROCTORING, S3_PUBLIC_URL, CDN_URL
#   LLM extras       OPENAI_FAST_MODEL, EMBEDDING_MODEL, ANTHROPIC_API_KEY,
#                    GOOGLE_API_KEY, AI_RATE_LIMIT_PER_USER_MIN,
#                    AI_RATE_LIMIT_PER_USER_DAY, AI_MAX_TOKENS,
#                    AI_RESPONSE_CACHE_TTL, AI_COST_BUDGET_MONTHLY_USD
#                    (/api/ai enforces its own in-code caps: 500 chars, 12/min)
#   Vector search    VECTOR_DIMENSIONS, RAG_CHUNK_SIZE, RAG_CHUNK_OVERLAP,
#                    RAG_TOP_K — no pgvector, no RAG
#   Proctoring       PROCTORING_EVIDENCE_RETENTION_DAYS,
#                    PROCTORING_SNAPSHOT_INTERVAL_SECONDS, MOCK_TEST_DESKTOP_ONLY,
#                    ANSWER_AUTOSAVE_INTERVAL_SECONDS
#   Third party      SENTRY_DSN, GA4_MEASUREMENT_ID, GOOGLE_TAG_MANAGER_ID,
#                    GOOGLE_SEARCH_CONSOLE_VERIFICATION, CLOUDFLARE_API_TOKEN,
#                    CLOUDFLARE_ZONE_ID, WHATSAPP_NUMBER, WHATSAPP_PROVIDER,
#                    WHATSAPP_API_KEY, WHATSAPP_TEMPLATE_ENQUIRY,
#                    WHATSAPP_TEMPLATE_FOLLOWUP,
#                    NEXT_PUBLIC_GA4_MEASUREMENT_ID, NEXT_PUBLIC_WHATSAPP_NUMBER,
#                    NEXT_PUBLIC_CDN_URL
#                    (no analytics or Sentry is installed; the WhatsApp number is
#                    a constant in lib/site.ts)
#   Dead guards      ADMIN_2FA_REQUIRED, COOKIE_SECURE, APP_NAME, TIMEZONE
#
# Two notes for whoever prunes next:
#   * `APP_NAME` and `TIMEZONE` are still declared on `Settings` but read by
#     nothing, so setting them does nothing. They are listed above rather than
#     silently retained.
#   * .env.prod.example lists REFRESH_TOKEN_IN_COOKIE, REFRESH_COOKIE_SAMESITE
#     and REQUIRE_ORIGIN_CHECK_ON_COOKIE_AUTH, and claims production refuses to
#     boot without them. No such settings exist in app/config.py — the cookie is
#     unconditional, SameSite=strict, and the Origin check is on. That file is
#     wrong and is a Phase 8.2 item.
