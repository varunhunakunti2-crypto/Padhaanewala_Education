# ============================================================================
# PADHAANEWALA - ENVIRONMENT VARIABLES
# Copy this file to .env.development / .env.staging / .env.production and fill values.
# NEVER commit real values to Git.
# ============================================================================

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=Padhaanewala
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:3000
# Hosts accepted in the Host header. REQUIRED in production. Never "*".
ALLOWED_HOSTS=localhost,127.0.0.1
# Number of reverse proxies in front of the app (Caddy/Cloudflare/nginx = 1).
# X-Forwarded-For is only honoured when this matches the real topology, because
# the header is client-controlled and would otherwise allow rate-limit bypass
# and audit-log spoofing. 0 = ignore the header, use the socket peer.
TRUSTED_PROXY_HOPS=0
TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
# 5433 is the port docker-compose.dev.yml publishes for the container
# (5433:5432). Only 5432 if you run a native Windows PostgreSQL instead.
DB_PORT=5433
DB_NAME=padhaanewala_dev
DB_USER=padhaanewala
DB_PASSWORD=change-me
# Driver MUST match requirements.txt: psycopg2-binary is installed,
# asyncpg is not. These DB_* fields are informational only - DATABASE_URL
# is what the application actually connects with.
DATABASE_URL=postgresql+psycopg2://padhaanewala:change-me@localhost:5433/padhaanewala_dev
# Connection pool. Keep max_connections on the server above
# DB_POOL_SIZE + DB_MAX_OVERFLOW + headroom for the seed scripts and psql.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# REDIS / CACHE / QUEUE
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_TTL_HOMEPAGE=300
CACHE_TTL_LIST=300
CACHE_TTL_DETAIL=300
CACHE_TTL_SCHOLARSHIP=600
CACHE_TTL_EXAM=600
CACHE_TTL_BLOG=600
CACHE_TTL_STATIC=3600

# ---------------------------------------------------------------------------
# AUTH / SECURITY
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
MAX_ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
ADMIN_2FA_REQUIRED=false
COOKIE_SECURE=false

# Bootstrap admin account - read by backend/scripts/seed_admin.py, not by the app.
# ADMIN_PASSWORD has no default on purpose: the script refuses to run without it.
# ADMIN_EMAIL_ALLOWLIST is a hard gate (R8.1) - the script will not touch any
# other account, so a typo in ADMIN_EMAIL cannot promote a real student.
# users.mobile is NOT NULL + UNIQUE, so the admin needs a unique mobile here.
ADMIN_EMAIL=contact@padhaanewala.in
ADMIN_EMAIL_ALLOWLIST=contact@padhaanewala.in
ADMIN_PASSWORD=
ADMIN_NAME=Padhaanewala Admin
ADMIN_MOBILE=9999999999
ADMIN_ROLES=admin,super_admin

# ---------------------------------------------------------------------------
# EMAIL (SMTP / SendGrid / AWS SES)
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USER=change-me
EMAIL_SMTP_PASSWORD=change-me
EMAIL_API_KEY=change-me
EMAIL_FROM_EMAIL=no-reply@padhaanewala.in
EMAIL_FROM_NAME=Padhaanewala
EMAIL_VERIFICATION_REQUIRED=true

# ---------------------------------------------------------------------------
# SMS / OTP (MSG91 / Twilio)
# ---------------------------------------------------------------------------
SMS_PROVIDER=msg91
SMS_API_KEY=change-me
SMS_SENDER_ID=PADNEWL
SMS_DLT_TEMPLATE_ID=change-me

# ---------------------------------------------------------------------------
# OBJECT STORAGE (AWS S3 / Cloudflare R2)
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_BUCKET_MEDIA=padhaanewala-media
S3_BUCKET_PROCTORING=padhaanewala-proctoring
S3_PUBLIC_URL=
CDN_URL=

# ---------------------------------------------------------------------------
# AI / LLM (OpenAI / Anthropic / Google) - BACKEND ONLY, never in frontend
# ---------------------------------------------------------------------------
OPENAI_API_KEY=change-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-ada-002
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
AI_RATE_LIMIT_PER_USER_MIN=20
AI_RATE_LIMIT_PER_USER_DAY=100
AI_MAX_TOKENS=1000
AI_RESPONSE_CACHE_TTL=3600
AI_COST_BUDGET_MONTHLY_USD=100

# ---------------------------------------------------------------------------
# PGVECTOR / VECTOR SEARCH
# ---------------------------------------------------------------------------
VECTOR_DIMENSIONS=1536
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_TOP_K=10

# ---------------------------------------------------------------------------
# MOCK TESTS / PROCTORING
# ---------------------------------------------------------------------------
PROCTORING_EVIDENCE_RETENTION_DAYS=90
PROCTORING_SNAPSHOT_INTERVAL_SECONDS=30
MOCK_TEST_DESKTOP_ONLY=true
ANSWER_AUTOSAVE_INTERVAL_SECONDS=30

# ---------------------------------------------------------------------------
# THIRD-PARTY SERVICES
# ---------------------------------------------------------------------------
SENTRY_DSN=
GA4_MEASUREMENT_ID=
GOOGLE_TAG_MANAGER_ID=
GOOGLE_SEARCH_CONSOLE_VERIFICATION=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
WHATSAPP_NUMBER=
WHATSAPP_PROVIDER=wati
WHATSAPP_API_KEY=
WHATSAPP_TEMPLATE_ENQUIRY=
WHATSAPP_TEMPLATE_FOLLOWUP=

# ---------------------------------------------------------------------------
# FRONTEND (Next.js) - ONLY vars prefixed NEXT_PUBLIC_ are exposed to browser
# ---------------------------------------------------------------------------
# BACKEND_URL is read ONLY on the Next.js server (lib/api-server.ts and the
# /api/v1 rewrite in next.config.ts). Never prefix it - that would ship an
# internal hostname to the browser.
BACKEND_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL is the browser-visible base. Leave it UNSET in
# development: lib/api.ts then defaults to the relative "/api/v1", which the
# rewrite in next.config.ts forwards to BACKEND_URL. Same-origin, so no CORS.
# If you must set it, it MUST include the /api/v1 suffix:
#   NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# next.config.ts strips a trailing /api/v1 before proxying; lib/api.ts does not.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CDN_URL=