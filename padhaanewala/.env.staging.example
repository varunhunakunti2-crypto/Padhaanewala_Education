# ==============================================================================
# STAGING ENVIRONMENT TEMPLATE - PLACEHOLDERS ONLY
# ==============================================================================
# Staging is a separate environment. Generate its own credentials; never copy
# values from development (.env.example / .env.development) or production
# (.env.prod.example / .env.production.secrets).
#
# This file is tracked and MUST stay empty. The real .env.staging stays ignored.
# ==============================================================================

APP_ENV=staging
APP_URL=
API_URL=
CORS_ORIGINS=
ALLOWED_HOSTS=

# --- Private credentials (generate fresh for staging) -------------------------
DATABASE_URL=
DB_PASSWORD=
SECRET_KEY=
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
EMAIL_API_KEY=
SMS_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Frontend (public values only) --------------------------------------------
BACKEND_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=

SITE_ADDRESS=
ACME_EMAIL=
