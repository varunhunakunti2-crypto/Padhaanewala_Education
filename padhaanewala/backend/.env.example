# ==============================================================================
# BACKEND PRIVATE CREDENTIALS - EMPTY PLACEHOLDERS ONLY
# ==============================================================================
# Copy to `backend/.env.development`, `.env.staging`, or `.env.production`, or
# inject the same names from your secrets manager / CI secret store.
#
# This file is tracked and MUST stay empty. Real values live only in gitignored
# .env files or in a secrets manager. Non-secret defaults (ports, TTLs, feature
# flags) are documented in ../.env.example, which is the executable development
# template validated by backend/tests/test_env_example.py.
#
# Never reuse a credential across development, staging and production.
# ==============================================================================

# --- Database -----------------------------------------------------------------
DATABASE_URL=
DB_PASSWORD=

# --- Application / JWT signing -------------------------------------------------
# Generate a unique value per environment; JWT_SECRET_KEY and
# JWT_REFRESH_SECRET_KEY must differ. Production refuses the default values.
SECRET_KEY=
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# --- Email provider (SendGrid, SMTP, etc.) ------------------------------------
EMAIL_API_KEY=
EMAIL_SMTP_PASSWORD=

# --- SMS provider (MSG91, etc.) ------------------------------------------------
SMS_API_KEY=
SMS_DLT_TEMPLATE_ID=

# --- AI providers (used by the backend proxy, never the browser) --------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Object storage / CDN ------------------------------------------------------
# The application reads S3_ACCESS_KEY / S3_SECRET_KEY. If you use AWS IAM keys,
# map AWS_ACCESS_KEY_ID -> S3_ACCESS_KEY and AWS_SECRET_ACCESS_KEY -> S3_SECRET_KEY.
S3_ACCESS_KEY=
S3_SECRET_KEY=
CLOUDFLARE_API_TOKEN=

# --- Messaging / monitoring / local admin bootstrap ---------------------------
WHATSAPP_API_KEY=
SENTRY_DSN=
ADMIN_PASSWORD=
