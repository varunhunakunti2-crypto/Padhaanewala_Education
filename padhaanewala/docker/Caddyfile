# Padhaanewala — edge.
#
# Topology, and the two properties that follow from it:
#
#   Internet ──:443──> Caddy (automatic TLS)
#                      ├── /*          → frontend:3000  (Next.js standalone)
#                      └── /api/v1/*   → frontend:3000  → backend:8000
#
# 1. The backend port is never published. `next.config.ts` proxies /api/v1 to it,
#    so the browser is always same-origin. That is what makes the HttpOnly
#    refresh cookie work, and it means CORS is irrelevant to external traffic.
# 2. Caddy is the only process with a route to the internet, so the server
#    banner is stripped here, but the security headers are written by the
#    application (`frontend/proxy.ts`) — see the comment in the header block.
{
	# Let's Encrypt/ZeroSSL certificates over HTTP-01. Caddy solves the challenge
	# on 80 before the 443 listener is available, which is why both ports are
	# published even though only HTTPS is served.
	email {$ACME_EMAIL}

	# Do not advertise the Caddy version. It is free reconnaissance, and there is
	# no cost to hiding it.
	admin off
}

# Plain HTTP exists only to redirect and to answer the ACME challenge. Nothing is
# served from it.
:80 {
	# Not `redir` — that would also redirect the ACME challenge and break issuance
	# for a domain whose DNS is not yet pointed at this host. The challenge path is
	# answered, everything else is redirected to the origin form.
	@acme path /.well-known/acme-challenge/*
	handle @acme {
		respond 200
	}

	# The edge health check is answered here over plain HTTP rather than being
	# redirected. Two reasons, and the second is the one that actually bit:
	#
	#   * a monitor probing over HTTP wants a 200, not a redirect chain into a TLS
	#     handshake; and
	#   * following the redirect to https://<ip>/ fails outright, because the
	#     certificate is issued for the site *name*, not for 127.0.0.1. That is
	#     what left the container permanently at "health: starting" while the
	#     site itself served traffic perfectly.
	handle /healthz {
		respond "ok" 200
	}

	# The redirect target needs the *public* HTTPS port, and Caddy cannot know
	# it. Caddy sees the request on container port 80 and knows only that its
	# own TLS listener is on 443, but the host publishes that listener on
	# whatever port the operator chose — 28443 in the localtest stack, 443 in
	# production. `{host}` is the Host header *minus* its port, so a bare
	# `https://{host}{uri}` sends the visitor to port 443, which on a remapped
	# stack is not published at all: the browser gets ERR_CONNECTION_REFUSED
	# and the redirect looks broken.
	#
	# `HTTPS_PORT_SUFFIX` carries the difference. It is empty in production,
	# where 443 is the real port and the canonical URL has no port in it, and
	# it is `:28443` in the localtest stack. The default is empty so a
	# deployment that never sets it behaves exactly as before.
	#
	# Note that this is the *fallback* path. A request whose Host matches the
	# `{$SITE_ADDRESS}` site never reaches this block — Caddy's own automatic
	# HTTP->HTTPS redirect answers it first, and that one is correct by
	# construction, because the site address carries the port:
	# `SITE_ADDRESS=localhost:28443` makes Caddy redirect to
	# `https://localhost:28443/...`. See the note on the site block below.
	handle {
		redir https://{host}{$HTTPS_PORT_SUFFIX:}{uri} permanent
	}
}

# The site address may carry a port, and that is not a cosmetic detail.
#
# `SITE_ADDRESS=padhaanewala.in` in production: Caddy listens on 443 and its
# automatic HTTP->HTTPS redirect sends the visitor to `https://padhaanewala.in/`.
#
# `SITE_ADDRESS=localhost:28443` in the localtest stack: Caddy listens on 28443
# *inside the container* (so the host must publish 28443->28443, not
# 28443->443), and the automatic redirect becomes
# `https://localhost:28443/...` — with the port, which is the whole point.
# Without the port in the address, Caddy redirects to `https://localhost/...`,
# i.e. port 443, which the localtest stack does not publish.
#
# The certificate is unaffected: Caddy's internal CA keys it by hostname, so a
# port-qualified address still gets a certificate for `localhost` with
# `DNS Name=localhost` in the SAN. The port is not part of the name.
#
# The port is NOT part of the name the backend accepts, either. `ALLOWED_HOSTS`
# holds hostnames only, and `allowed_host_list` in the backend's config.py
# strips the port when it derives hosts from APP_URL and API_URL.
{$SITE_ADDRESS:padhaanewala.in} {
	encode zstd gzip

	# --- Security headers -------------------------------------------------
	#
	# Only the two that belong at the edge, and each for a specific reason.
	#
	# HSTS is set here *as well as* in the application (`frontend/proxy.ts`,
	# Phase 5.2). The duplication is deliberate and is the one header worth
	# having twice, because it is the one header that must not depend on the
	# application being up and correct: a 500 from a bad deploy, or a route that
	# crashes before the proxy runs, is precisely when a browser should be
	# recording that this host is HTTPS-only. It also covers the responses Caddy
	# generates itself and never forwards — `/healthz` and the redirect on :80.
	# Browsers take the strictest HSTS they are given and the two values are
	# identical, so there is nothing to intersect.
	#
	# What is deliberately NOT set here: Content-Security-Policy, X-Frame-Options,
	# X-Content-Type-Options, Referrer-Policy, Permissions-Policy. The
	# application is the single source of truth for all five, and for
	# Permissions-Policy it has to be: a blanket `camera=()` at the edge would
	# veto the `camera=(self)` the app grants to `/mock-tests`, because the
	# browser intersects every policy it receives and the most restrictive wins.
	# Two sources for *that* header is how the intersection gets broken.
	header {
		# Hides the server banner. Also stripped application-side by
		# `poweredByHeader: false`; here because this is the only layer that
		# sees Caddy's own responses too.
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# --- Health, for the load balancer and for uptime monitoring ------------
	#
	# Served by Caddy itself, not proxied. If it were proxied to the frontend it
	# would fail whenever the frontend is the thing that is down, which is
	# exactly when a health endpoint is needed. Phase 8.5 builds alerting on this.
	handle /healthz {
		respond "ok" 200
	}

	# The application's own health check, which verifies a real `SELECT 1`
	# round trip and reports the latency.
	#
	# Routed straight to the backend rather than through the frontend, because
	# `next.config.ts` only rewrites `/api/v1/*` and FastAPI serves this at the
	# application root. Without this line `/health` reaches Next, which has no
	# such route, and returns 404 — a load balancer would then restart a
	# perfectly healthy container forever.
	#
	# The only backend path Caddy exposes directly. The rest of the API goes
	# through the frontend rewrite, which is what keeps the browser same-origin.
	handle /health {
		reverse_proxy backend:8000
	}

	# --- API ---------------------------------------------------------------
	#
	# Routed to the *frontend*, not the backend. `next.config.ts` rewrites
	# /api/v1 to the backend internally, and the browser therefore only ever
	# talks to this origin — one less hop, and the reason the refresh cookie can
	# be SameSite=strict.
	handle /api/v1/* {
		reverse_proxy frontend:3000
	}

	# --- Everything else ---------------------------------------------------
	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
		# Query strings can contain a one-time email-verification or
		# password-reset token, because /verify-email and /reset-password are
		# front-end routes that read `?token=`. Logging them verbatim writes
		# bearer credentials into a log file that Phase 9.5 will want to be able
		# to delete.
		level INFO
	}
}
