# ==============================================================================
# FRONTEND ENVIRONMENT TEMPLATE - PUBLIC / SERVER-SIDE PROXY SETTINGS ONLY
# ==============================================================================
# Copy to `.env.development`, `.env.staging`, or `.env.production` and fill in.
#
# NEVER put private credentials here. Anything prefixed NEXT_PUBLIC_ is embedded
# in the browser JavaScript bundle and is readable by every visitor. API keys,
# database passwords, JWT secrets and provider tokens belong in the backend
# environment or a secrets manager (see ../backend/.env.example).
#
# Leave values empty where there is no safe non-secret default.
# ==============================================================================

# Browser-visible settings (safe to be public).
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_PHONE=
NEXT_PUBLIC_MEDIA_MAX_BYTES=
NEXT_PUBLIC_PDF_IMPORT_MAX_BYTES=

# Server-only Next.js settings (rewrites / route handlers / CSP).
# These are NOT sent to the browser, but are still not secret storage.
BACKEND_URL=
APP_ENV=
CSP_IMAGE_HOSTS=
