# ============================================================================
# ENVIRONMENT FILES - NEVER COMMIT REAL VALUES
# ============================================================================
.env*
!.env.example

# ============================================================================
# NODE (frontend)
# ============================================================================
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vercel/

# ============================================================================
# PYTHON (backend)
# ============================================================================
venv/
.venv/
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.htmlcov/
.coverage
.coverage.*
pytest-report.xml
junit.xml
*.log
# uvicorn/npm stdout+stderr captures. `*.log` does not match these, and a
# stderr capture can contain a SQLAlchemy error whose message embeds the
# connection string and credentials.
*.err
*.out

# ============================================================================
# RUNTIME STATE (backend)
# ============================================================================
# `var/` holds everything the running app produces: pg_dump backups, uploaded
# college images, and files written by the upload tests. A `.dump` is a whole
# copy of the development database, so committing one publishes every row in
# it. Nothing here is source -- all of it is reproducible or disposable.
var/

# ============================================================================
# IDE / OS
# ============================================================================
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ============================================================================
# DEPENDENCY LOCKFILES MISC
# ============================================================================
.pnp.*
.yarn/*
!.yarn/patches